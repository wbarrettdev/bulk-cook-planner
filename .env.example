# Copy this file to .env and fill in what you want. Git ignores .env.
# Every setting is optional: the services start without any of them.

# Foods the pairing tool should never suggest, separated by commas.
PAIRING_RULES_NEVER=

# A free USDA FoodData Central key, from https://fdc.nal.usda.gov/api-key-signup.
# Left empty, the shared DEMO_KEY is used, which allows only a few dozen lookups an hour.
USDA_API_KEY=

# Country tags whose products an Open Food Facts search lists first, such as en:spain,en:france.
OPEN_FOOD_FACTS_COUNTRIES=

# The database password, if you want your own. It only takes effect the first time the db
# service starts. The database won't start with an empty one.
#POSTGRES_PASSWORD=
